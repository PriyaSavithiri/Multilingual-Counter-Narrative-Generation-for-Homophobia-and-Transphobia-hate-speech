# Copy this file to .env (or set these as real environment variables).
# Nothing here is required for the default local Ollama backend.

# Required only for --backend hf-inference
HF_TOKEN=

# Required only for --backend openai (optional fallback backend, never default)
OPENAI_API_KEY=" "

# Optional: override the Ollama host (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional: override the embedding model used for RAG
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Optional: number of RAG passages retrieved per query variant (input-language
# and English queries are each capped at this before merge/dedupe/rerank)
RAG_TOP_K=5

# Deep-Dive round count (K) for implicit hate - hardcoded default is 3,
# overridable here for experimentation. Fast-Track (explicit hate) is always
# exactly 1 round and is not affected by this variable.
DEEP_DIVE_ROUNDS=3

# Restricted developer/debug mode - BOTH default to false, and are
# independent of each other (enabling one does not enable the other).
# SHOW_INTERNAL_TRACES: shows a clearly-marked, warning-labelled developer
#   expander in the Streamlit UI with a short excerpt of the internal
#   Prosecutor argument per round - never the full text, never in the
#   normal result view, never in downloads.
# SAVE_INTERNAL_TRACES: persists a minimized debug trace (excerpt only) to
#   new_arch/outputs/debug/ - a restricted path excluded from normal
#   generations/traces output and from downloadable results.
SHOW_INTERNAL_TRACES=false
SAVE_INTERNAL_TRACES=false

# Optional web search (Tavily) - a SUPPLEMENT to local RAG evidence, never a
# replacement. Off by default. When true, every Defender evidence-gathering
# call runs BOTH local RAG and a live web search (not only when local RAG is
# empty). Requires TAVILY_API_KEY (get one at https://tavily.com) and the
# `tavily-python` package (pip install tavily-python) - missing either raises
# a clear error only when a search is actually attempted, never guessed.
# Skipped entirely in --rag-mode no_rag, same as local retrieval.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=" "
WEB_SEARCH_MAX_RESULTS=3
